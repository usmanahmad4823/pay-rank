# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Stripe Secret & Publishable Keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Webhook Secret (from `stripe listen` or dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Safepay Credentials (sandbox | production)
SAFEPAY_ENVIRONMENT="sandbox"
SAFEPAY_API_KEY="sec_..."
NEXT_PUBLIC_SAFEPAY_CLIENT_ID="sec_..."
SAFEPAY_WEBHOOK_SECRET="whsec_..."

# Development / Mock Payment Bypass (Set to "true" for instant testing without payment API keys)
MOCK_PAYMENTS="true"
