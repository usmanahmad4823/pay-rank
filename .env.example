# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pay_rank?schema=public"

# Stripe Secret & Publishable Keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Webhook Secret (from `stripe listen` or dashboard)
STRIPE_WEBHOOK_SECRET="whsec_..."

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Development / Mock Payment Bypass (Set to "true" for instant testing without Stripe API keys)
MOCK_PAYMENTS="true"
