generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Restaurant {
  id                 String    @id @default(uuid())
  name               String
  normalizedName     String    @map("normalized_name")
  city               String
  normalizedCity     String    @map("normalized_city")
  province           String?   @map("province")
  normalizedProvince String?   @map("normalized_province")
  cuisine            String?
  description        String?
  logoUrl            String    @map("logo_url")
  totalPaidCents     Int       @default(0) @map("total_paid_cents")
  ownerEditToken     String    @unique @default(uuid()) @map("owner_edit_token")
  status             String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | VERIFIED
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  payments           Payment[]

  @@index([normalizedCity, totalPaidCents(sort: Desc)])
  @@index([normalizedProvince, totalPaidCents(sort: Desc)])
  @@index([totalPaidCents(sort: Desc)])
  @@index([normalizedName, normalizedCity])
  @@map("restaurants")
}

model Payment {
  id                    String     @id @default(uuid())
  restaurantId          String     @map("restaurant_id")
  restaurant            Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amountCents           Int        @map("amount_cents")
  stripePaymentIntentId String?    @unique @map("stripe_payment_intent_id")
  stripeSessionId       String?    @unique @map("stripe_session_id")
  safepayTracker        String?    @unique @map("safepay_tracker")
  safepayReference      String?    @unique @map("safepay_reference")
  safepaySignature      String?    @map("safepay_signature")
  paymentMethod         String     @default("safepay") @map("payment_method")
  refunded              Boolean    @default(false) @map("refunded")
  refundedAmountCents   Int        @default(0) @map("refunded_amount_cents")
  status                String     @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED
  createdAt             DateTime   @default(now()) @map("created_at")

  @@map("payments")
}

model PageView {
  id        String   @id @default(uuid())
  ip        String?  @map("ip")
  path      String?  @map("path")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("page_views")
}

model SiteStats {
  id            String   @id @default("global")
  totalVisitors Int      @default(0) @map("total_visitors")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("site_stats")
}
